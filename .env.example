# ─── Core (required) ────────────────────────────────────────────────────────
# PostgreSQL 14+ connection string. Use a pooled URL on serverless hosts.
DATABASE_URL="postgresql://sewersquad:sewersquad@localhost:5432/sewersquad?schema=public"
# Direct (non-pooled) URL, used only to run migrations during the Vercel build. Optional;
# DATABASE_URL_UNPOOLED (set by Vercel's Neon integration) is used when this is empty.
DIRECT_DATABASE_URL=""
# Public base URL; used in emails, Stripe return URLs and links.
APP_URL="http://localhost:3000"
# ≥32 random chars. Encrypts MFA secrets at rest. `openssl rand -base64 48`
# Rotating it invalidates enrolled MFA (users must re-enroll).
APP_ENCRYPTION_KEY=""
# One-time code for the /setup page that creates the first owner account (≥16 chars).
# The page disables itself once the owner exists; you can delete this afterwards.
SETUP_TOKEN=""
# Bearer secret for /api/cron/*. Vercel Cron sends it automatically when set.
CRON_SECRET=""
# Super admin, admin and accounting must use TOTP MFA. Keep "true" in production.
REQUIRE_ADMIN_MFA="true"
SESSION_TTL_HOURS=12

# ─── File storage ──────────────────────────────────────────────────────────
# "s3" for production (AWS S3, Cloudflare R2, MinIO, …). Bucket must be PRIVATE.
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage"
# Production refuses local storage unless you run one server with a persistent, backed-up disk.
ALLOW_LOCAL_STORAGE="false"
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""            # e.g. https://<account>.r2.cloudflarestorage.com (blank for AWS)
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE=""    # "true" for MinIO

# ─── Stripe (online payments) — leave blank to disable "Pay" buttons ──────────
# Start with sk_test_… and a test-mode webhook. See docs/integrations.md before going live.
STRIPE_SECRET_KEY=""
# Signing secret of the endpoint pointing at {APP_URL}/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=""
STRIPE_ENABLE_ACH="false"
# A live key (sk_live_…) is ignored until this is "true". Flip it only after the test-mode checklist passes.
STRIPE_LIVE_APPROVED="false"

# ─── Email (Resend) — blank = emails recorded as "skipped", not sent ────────
RESEND_API_KEY=""
EMAIL_FROM=""             # e.g. "Sewer Squad <billing@yourdomain.com>" (verified domain)
AGENT_API_KEY=""                 # read-only agent API key (32+ random chars); see docs/agent-api.md
RESEND_INBOUND_WEBHOOK_SECRET=""   # whsec_… from Resend → Webhooks (event: email.received) → leads
LEAD_INBOXES="sewersquadservices@gmail.com,sales@sewersquadservices.com"

# ─── SMS (Twilio, optional) ─────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# ─── Maps (Google) — one browser key, restricted to your site's domain, with the Maps
#     JavaScript API and Geocoding API enabled. Redeploy after changing (built into the page).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# LOG_LEVEL="debug"
