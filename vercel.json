{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "[ -n \"$VERCEL_GIT_COMMIT_REF\" ] && [ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ]",
  "crons": [
    {
      "path": "/api/cron/schedule-plans",
      "schedule": "15 9 * * *"
    },
    {
      "path": "/api/cron/service-reminders",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/invoice-reminders",
      "schedule": "30 14 * * *"
    },
    {
      "path": "/api/cron/deliveries",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 8 * * *"
    }
  ]
}
